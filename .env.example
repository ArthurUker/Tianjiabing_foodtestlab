# 食品安全检验系统 - 环境配置文件示例
# 复制此文件并重命名为 .env 进行配置

# ====== 运行环境 ======
NODE_ENV=production
# 可选值: development, staging, production

# ====== 后端服务配置 ======
PORT=3002
# API-only 模式（推荐腾讯云生产）
SERVE_STATIC=false

# ====== 数据库配置 ======
# Prisma + PostgreSQL（开发/测试/生产统一，Schema-per-tenant 方案②）
# DATABASE_URL 使用 postgresql:// 连接串
# 生产示例: postgresql://foodtestlab:强密码@127.0.0.1:5432/foodtestlab
DATABASE_URL="postgresql://<db_user>:<strong-password>@127.0.0.1:5432/foodtestlab"

# ====== JWT 配置 ======
# JWT 密钥 — 生产必须修改！生成命令: openssl rand -hex 32
# 注意：使用弱密钥/占位符会导致 backend/server.js 启动直接失败（已知弱密钥黑名单拦截）
JWT_SECRET=please-run-openssl-rand-hex-32-and-replace-this
JWT_EXPIRES_IN=7d
# 兼容当前后端读取字段
JWT_EXPIRE=7d

# ====== 跨域配置 ======
# 允许跨域来源，多个域名用逗号分隔
# 生产环境必须填写实际服务器公网 IP（例如: http://<your-server-ip>:8082）
# P1-13: 生产 IP 通过 .env 配置，不再硬编码在 server.js 中
CORS_ORIGIN=http://localhost:8082,http://127.0.0.1:8082,http://<your-server-ip>:8082

# ====== API 配置 ======
API_BASE_URL=http://localhost:3002
API_TIMEOUT=30000
# 毫秒

# ====== 缓存配置 ======
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_DEFAULT_TTL=3600000
# 毫秒（默认 1 小时）
CACHE_ENABLE_LOCALSTORAGE=true

# ====== Seed 初始密码配置 ======
SEED_ADMIN_PASSWORD=your-strong-password-here
SEED_OPERATOR_PASSWORD=your-strong-password-here
SEED_VIEWER_PASSWORD=your-strong-password-here

# ========== 数据库初始化密码（seed.js 使用）==========
# 执行 prisma db seed 前必须配置以上三项，否则 seed 将拒绝运行
# 密码要求：至少8位，包含大小写字母和数字

# ====== 认证配置 ======
AUTH_TOKEN_KEY=auth_token
AUTH_TOKEN_REFRESH_INTERVAL=600000
# 毫秒（默认 10 分钟）

# ====== 日志配置 ======
LOG_LEVEL=info
# 可选值: debug, info, warn, error
LOG_FILE=logs/app.log

# ====== 功能开关 ======
FEATURE_CACHE=true
FEATURE_VALIDATION=true
FEATURE_AUDIT_LOG=true
FEATURE_OFFLINE_MODE=false

# ====== 开发工具 ======
# 仅在开发环境使用
DEBUG_MODE=false
MOCK_API=false
