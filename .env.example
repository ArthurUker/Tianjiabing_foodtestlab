# =====================================================================
# 田家炳食品检验系统 - 环境配置模板（与代码实际读取的 process.env.* 一致）
# 复制为 backend/.env 使用。生产部署时 deploy/deploy.sh 会自动生成本文件，
# 手动部署 / 本地开发才需要手工填写。
# 标注说明：
#   [必填]   缺失会导致启动失败或功能拒绝执行（fail-fast，不会静默降级）
#   [可选]   有安全合理的代码内默认值，不配置也能运行
# =====================================================================

# ====== 运行环境 ======
# [可选] production / development；production 下 seed 默认拒绝执行（需 SEED_ALLOW_PROD=true）
NODE_ENV=production

# ====== 后端服务 ======
# [可选] 默认 3002；生产 deploy.sh 写入 API_PORT（当前适配文件为 3000，仅监听本机，经 Caddy 反代）
PORT=3000
# [可选] 默认 false（API-only，静态资源交给 Caddy/Nginx）；设为 true 时由 Node 直接托管前端
SERVE_STATIC=false
# [可选] express.json 请求体上限，默认 8mb（与 Caddy request_body max_size 8MB 对齐）
# BODY_LIMIT=8mb
# [可选] 配置后启用 HSTS 响应头（仅 HTTPS 域名部署时设置）
# DOMAIN=

# ====== 数据库（PostgreSQL + Schema-per-tenant）======
# [必填] 缺失时 Prisma 初始化失败、租户初始化直接 throw。不要带 ?schema= 参数
#（tenantClient.js 会按租户自动追加）。生成示例：
#   postgresql://foodsentinel:<强密码>@127.0.0.1:5432/foodsentinel
DATABASE_URL="postgresql://<db_user>:<strong-password>@127.0.0.1:5432/foodsentinel"

# ====== JWT ======
# [必填] 缺失或命中弱密钥黑名单时 server.js 直接 process.exit(1)（fail-fast）
# 生成命令: openssl rand -hex 32
JWT_SECRET=please-run-openssl-rand-hex-32-and-replace-this
# [可选·建议生产显式设置] 刷新令牌密钥；缺省回退为 "<JWT_SECRET>:refresh"（派生值，非独立密钥）
# JWT_REFRESH_SECRET=
# [可选] 访客/旧令牌有效期，默认 7d
JWT_EXPIRE=7d
# [可选] 访问令牌有效期，默认 30m
# JWT_ACCESS_EXPIRE=30m
# [可选] 刷新令牌有效期，默认 7d
# JWT_REFRESH_EXPIRE=7d

# ====== 跨域 ======
# [生产必填] 不允许包含 "*"（credentials:true 恒开，含通配符启动即退出）。
# 未配置时回退 localhost 白名单——生产漏配的表现是浏览器跨域报错，而非崩溃。
CORS_ORIGIN=http://<公网IP>:8080
# [可选] 额外允许的主机名白名单（逗号分隔，如 1.2.3.4,127.0.0.1:3002）
# CORS_HOSTNAMES=

# ====== 种子账号（seed.js / 租户初始化用）======
# [seed 时必填] 三项缺一，prisma db seed 直接 exit(1)；生产运行 seed 还需 SEED_ALLOW_PROD=true
SEED_ADMIN_PASSWORD=your-strong-password-here
SEED_OPERATOR_PASSWORD=your-strong-password-here
SEED_VIEWER_PASSWORD=your-strong-password-here
# [可选] 生产环境放行 seed（deploy.sh 仅在首次部署时临时置位，不落盘）
# SEED_ALLOW_PROD=true

# ====== 多租户（方案② Schema-per-tenant）======
# [首次建校必填] 逗号分隔的学校代码（仅小写字母/数字/连字符）
# 为空则 provision-tenants.js 跳过多租户初始化（仅用 public 共享 schema）
SCHOOL_CODES=
# [可选] 学校显示名，变量名格式 SCHOOL_NAME_<code>
# [可选] 默认 schema，默认 public
# DEFAULT_SCHEMA=public
# [可选] 租户 PrismaClient 缓存上限，默认 25
# MAX_TENANT_CLIENTS=25
# [可选] 每租户连接池上限，默认 3（注意 25×3 + 基础连接 需 < PG max_connections=100）
# TENANT_CONNECTION_LIMIT=3
# [可选] 启动期租户 schema 自愈同步，默认开启；设为 false 关闭
# AUTO_SYNC_TENANTS=true
# [可选] db:sync 时跳过 prisma generate（deploy.sh §6.55 已使用）
# SKIP_PRISMA_GENERATE=1
# [危险·仅本地开发] 允许租户弱默认密码回退，生产严禁设置
# ALLOW_INSECURE_TENANT_PASSWORD=false

# ====== 限流与登录保护（均有默认值）======
# [可选] 全局限流：默认 1000 次 / 60000ms
# RATE_LIMIT_MAX_REQUESTS=1000
# RATE_LIMIT_WINDOW_MS=60000
# [可选] 登录限流：默认 10 次 / 15 分钟
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# [可选] 超管登录限流上限（见 userRoutes.js）
# SUPER_ADMIN_LOGIN_RATE_LIMIT_MAX=
# [可选] 登录失败锁定：默认 5 次 / 15 分钟
# LOGIN_FAIL_LOCK_THRESHOLD=5
# LOGIN_FAIL_LOCK_WINDOW_MS=900000

# ====== 认证内部参数（均有默认值，一般无需改动）======
# [可选] 吊销令牌表清理间隔，默认 15 分钟
# REVOKED_TOKENS_CLEANUP_INTERVAL_MS=900000
# [可选] 认证状态缓存 TTL，默认 30s
# AUTH_STATE_CACHE_TTL_MS=30000
# [可选] 刷新令牌重放宽限期（见 UserManager.js）
# REFRESH_REPLAY_GRACE_MS=

# ====== 安全告警扫描器 ======
# [可选] webhook 未配置时仅打进程日志
# SECURITY_ALERT_WEBHOOK_URL=
# [可选] 扫描间隔默认 5min，回看窗口默认 1h
# SECURITY_ALERT_INTERVAL_MS=300000
# SECURITY_ALERT_LOOKBACK_MS=3600000
# [可选] 测试/本地关闭扫描器
# SECURITY_ALERT_DISABLED=true

# ====== 问题反馈（钉钉群机器人推送，backend/routes/feedbackRoutes.js）======
# [可选] 钉钉群「自定义机器人」Webhook 地址（含 access_token，真实值只写服务器 .env，勿入库）。
#        未配置时反馈仅落 public.SystemLog 留档（FEEDBACK: 前缀），不推送
# DINGTALK_WEBHOOK_URL=
# [可选] 机器人安全方式选「加签」时填写密钥（SEC 开头的字符串）；「自定义关键词」方式无需填写。
#        消息文案固定含「反馈」二字，建议机器人关键词直接设为：反馈
# DINGTALK_SECRET=

# ====== 数据备份（P0 备份引擎，backend/lib/backupService.js）======
# [可选] 备份根目录。默认 backend/backups（本地）；生产部署建议 /var/backups/foodsentinel（系统盘）
# BACKUP_DIR=/var/backups/foodsentinel
# [可选] 本地备份保留天数，默认 7
# BACKUP_KEEP_DAYS=7
# [可选] 备份前磁盘剩余空间预检阈值（MB），不足则拒绝备份（fail-closed，防写满系统盘），默认 1024
# BACKUP_MIN_FREE_MB=1024
# [必填·生产] 备份加密主密钥模式（fail-closed，至少配置其一，否则备份拒绝执行）：
#   模式A【生产推荐】腾讯云 KMS 信封加密（CMK 不出 KMS，支持审计/轮换）——
#     需在 backend 目录 npm i tencentcloud-sdk-nodejs
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_KMS_REGION=ap-guangzhou
# TENCENT_KMS_KEY_ID=
#   模式B【仅开发/过渡】32 字节主密钥的 base64（生成：openssl rand -base64 32）。
#     ⚠️ 主密钥以明文存在于服务器环境，生产上线前必须切换到模式A
# BACKUP_MASTER_KEY=
# [可选] pg_dump 二进制路径（默认自动探测 /usr/lib/postgresql/<v>/bin/pg_dump）
# PG_DUMP_BIN=

# ====== 其他 ======
# [可选] 校徽外链主机白名单（逗号分隔）
# LOGO_ALLOWED_HOSTS=
# [可选] scripts/migrate-roles.mjs 附加 schema 列表
# EXTRA_SCHEMAS=
# [可选] 测试/Cypress 用的目标地址（仅测试脚本读取，运行时不读）
# BASE_URL=http://127.0.0.1:8080
