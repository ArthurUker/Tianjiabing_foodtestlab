# 食品安全测试系统 - 环境配置文件示例
# 复制此文件并重命名为 .env 进行配置

# ====== 环境 ======
NODE_ENV=development
# 可选值: development, staging, production

# ====== 后端服务配置 ======
PORT=3001
# API-only 模式（推荐腾讯云生产）
SERVE_STATIC=false

# 允许跨域来源，多个域名用逗号分隔。
# 无域名部署示例: http://159.75.106.179:8081
# 开发示例: http://localhost:5173,http://127.0.0.1:5500
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5500

# ====== Supabase配置 ======
SUPABASE_URL=https://your-supabase-instance.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# 注意: 在生产环境中，后端应该使用服务角色密钥
# 前端只应使用匿名密钥

# ====== JWT配置 ======
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
# 兼容当前后端读取字段
JWT_EXPIRE=7d

# ====== 数据库配置 ======
# 本项目使用 SQLite，DATABASE_URL 必须以 file: 开头
DATABASE_URL="file:./prisma/foodtestlab.db"

# ====== API配置 ======
API_BASE_URL=http://localhost:3001
API_TIMEOUT=30000
# 毫秒

# ====== 缓存配置 ======
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_DEFAULT_TTL=3600000
# 毫秒 (默认1小时)
CACHE_ENABLE_LOCALSTORAGE=true

# ====== 认证配置 ======
AUTH_TOKEN_KEY=auth_token
AUTH_TOKEN_REFRESH_INTERVAL=600000
# 毫秒 (默认10分钟)

# ====== 邮件配置 ======
MAIL_FROM=noreply@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
# 注意: 不要在前端代码中硬编码邮件凭证

# ====== 日志配置 ======
LOG_LEVEL=info
# 可选值: debug, info, warn, error
LOG_FILE=logs/app.log

# ====== 功能开关 ======
FEATURE_CACHE=true
FEATURE_VALIDATION=true
FEATURE_AUDIT_LOG=true
FEATURE_OFFLINE_MODE=false

# ====== 第三方服务 ======
# Google Analytics
GOOGLE_ANALYTICS_ID=

# ====== 开发工具 ======
# 仅在开发环境使用
DEBUG_MODE=false
MOCK_API=false
