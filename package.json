{
  "name": "foodsentinel",
  "type": "module",
  "version": "1.0.0",
  "description": "食品安全检验管理系统 - Pro版本",
  "main": "backend/server.js",
  "scripts": {
    "test": "npm run test:db && npm run test:unit",
    "test:watch": "jest --config jest.unit.config.cjs --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:unit": "jest --config jest.unit.config.cjs --coverage",
    "test:db": "jest --config jest.db.config.cjs",
    "test:entry-audit": "node tests/runners/audit-entry-coverage.mjs",
    "test:backend": "node tests/runners/run-backend-tests.mjs",
    "test:backend:list": "node tests/runners/run-backend-tests.mjs --list-only",
    "test:frontend": "jest --config jest.frontend.config.cjs",
    "test:coverage": "jest --config jest.unit.config.cjs --coverage --coverageDirectory=coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless --browser chrome",
    "test:e2e:report": "cypress run --reporter mochawesome",
    "test:all": "npm test && cypress run",
    "test:integration": "jest --config tests/integration/jest.integration.config.cjs",
    "test:isolation": "jest --config tests/isolation/jest.isolation.config.cjs",
    "start": "cd backend && npm start",
    "dev": "cd backend && npm run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:css": "tailwindcss -i ./frontend/css/tailwind.input.css -o ./frontend/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./frontend/css/tailwind.input.css -o ./frontend/css/tailwind.css --watch",
    "build": "node scripts/build-static.js && npm run build:css",
    "build:dev": "node scripts/build-static.js",
    "build:prod": "node scripts/build-static.js",
    "db:sync": "node backend/sync-tenant-schemas.mjs",
    "postinstall": "",
    "test:backend:fixture": "node backend/tests/t02c-instance-fixture.mjs",
    "test:live-api": "node backend/tests/t02c-live-api-harness.mjs"
  },
  "keywords": [
    "food-safety",
    "testing",
    "management",
    "system"
  ],
  "author": "foodsentinel",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.21.0",
    "babel-jest": "^29.5.0",
    "cypress": "^15.19.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "tailwindcss": "~3.4.0",
    "webpack": "^5.83.0",
    "webpack-cli": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
