{
  "name": "food-test-backend",
  "version": "3.1.0",
  "description": "Food Safety Testing System Backend API",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:sync": "node sync-tenant-schemas.mjs",
    "seed": "node prisma/seed.js",
    "dedupe:preview": "node prisma/dedupe-test-records.js",
    "dedupe:apply": "node prisma/dedupe-test-records.js --apply",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "food-safety",
    "testing",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
}
