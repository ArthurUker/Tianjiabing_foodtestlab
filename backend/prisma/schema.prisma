// Prisma Schema for Food Safety Testing Lab
// Database: PostgreSQL（开发 / 测试 / 生产统一，Schema-per-tenant 方案②）
// 每校业务数据落在独立 schema（schoolCode 即 schema 名，如 school-a），由应用层按登录学校 SET search_path 路由。
// 系统表（School / SchoolCustomization）始终位于 public schema（search_path 兜底位）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 用户管理 ==========

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  password_hash String
  full_name     String?
  phone         String?
  role          String   @default("user") // admin / manager / operator / viewer / user
  status        String   @default("active") // active / disabled
  school_code   String?  // 所属学校代码（方案②）；dev/test 共享 schema 时为空
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  last_login    DateTime?

  audit_logs    AuditLog[]
  test_records  TestRecord[]
  guests        Guest[]
  backups       Backup[]
}

// ========== 审计日志 ==========

model AuditLog {
  id            String   @id @default(cuid())
  user_id       String
  action        String   // login / create / update / delete / export / import
  resource_type String?  // test_record / user / backup / etc
  resource_id   String?
  details       String?  // JSON string for additional details
  ip_address    String?
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

// ========== 测试记录 ==========

model TestRecord {
  id            String   @id @default(cuid())
  record_code   String   @unique
  test_type     String   // pathogen / tableware / generic / custom
  test_name     String
  sample_info   String?  // JSON for sample details
  result_data   String?  // JSON for test results
  status        String   @default("pending") // pending / completed / failed / archived
  created_by    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  version       Int      @default(0)
  completed_at  DateTime?

  created_user  User     @relation(fields: [created_by], references: [id], onDelete: Restrict) // P1-08: 改为 Restrict，防止删用户时级联删除检测记录
  test_items    TestItem[]
  attachments   Attachment[]

  @@index([test_type])
  @@index([status])
  @@index([created_by])
  @@index([created_at])
}

// ========== 测试项目 ==========

model TestItem {
  id            String   @id @default(cuid())
  test_record_id String
  item_name     String
  item_code     String?
  result        String?  // positive / negative / qualified / unqualified / etc
  notes         String?
  created_at    DateTime @default(now())

  test_record   TestRecord @relation(fields: [test_record_id], references: [id], onDelete: Cascade)

  @@index([test_record_id])
}

// ========== 附件/文件 ==========

model Attachment {
  id            String   @id @default(cuid())
  test_record_id String?
  file_name     String
  file_path     String
  file_size     Int?     // bytes
  file_type     String?  // MIME type
  uploaded_at   DateTime @default(now())

  test_record   TestRecord? @relation(fields: [test_record_id], references: [id], onDelete: SetNull)

  @@index([test_record_id])
}

// ========== 访客管理 ==========

model Guest {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?
  password_hash String
  full_name     String?
  created_by    String
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  created_user  User     @relation(fields: [created_by], references: [id], onDelete: Restrict) // P1-08: 改为 Restrict，防止删用户时级联删除检测记录

  @@index([created_by])
}

// ========== 系统备份元数据 ==========

model Backup {
  id            String   @id @default(cuid())
  backup_name   String
  backup_path   String   @unique
  backup_size   Int?
  record_count  Int      @default(0)
  created_at    DateTime @default(now())
  created_by    String?
  notes         String?

  // P2-08: 关联用户外键约束（created_by 可为空，引用 User.id）
  created_user  User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([created_by])
}

// ========== 系统日志 ==========

model SystemLog {
  id            String   @id @default(cuid())
  level         String   // info / warn / error / debug
  message       String
  context       String?  // JSON
  created_at    DateTime @default(now())

  @@index([level])
  @@index([created_at])
}

// ========== 学校注册表（系统级，位于 public schema）==========

model School {
  id            String   @id @default(cuid())
  code          String   @unique // 学校代码，即 PostgreSQL schema 名（无前缀，如 school-a）
  name          String
  short_name    String?
  theme_color   String?  // 主题色（外观个性化）
  logo_url      String?
  status        String   @default("active") // active / disabled
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  customization SchoolCustomization? @relation("SchoolCustomization")
}

// ========== 学校定制配置（外观 / 字段个性化，位于 public schema）==========

model SchoolCustomization {
  id            String   @id @default(cuid())
  school_code   String   @unique // 与 School.code 对应
  school        School   @relation("SchoolCustomization", fields: [school_code], references: [code])
  // 可见检测类型（JSON 数组，如 ["tableware","pathogen"]）
  visible_types String?  // JSON array
  // 字段标签覆盖（JSON，如 {"testDate":"检测日期"}）
  field_labels  String?  // JSON object
  // 隐藏字段（JSON 数组）
  hidden_fields String?  // JSON array
  // 其它主题设置（JSON）
  theme_config  String?  // JSON object
  // 字段级规则（JSON，如 {"sampler":{"required":true},"note":{"required":false,"maxLength":200}}）
  field_rules   String?  // JSON object
  updated_at    DateTime @updatedAt
}
