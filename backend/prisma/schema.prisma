// Prisma Schema for Food Safety Testing Lab
// Database: PostgreSQL（开发 / 测试 / 生产统一，Schema-per-tenant 方案②）
// 每校业务数据落在独立 schema（school_<code>）。
// ⚠️ Prisma 会把表名硬编码为 datasource schema，SET search_path 对 model 查询无效，
//    故由 lib/tenantClient.js 为每个 schema 缓存一个带 ?schema= 连接串的 PrismaClient 实现路由。
// 系统表（School / SchoolCustomization）始终位于 public schema，由基础 prisma 单例直接访问。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 用户管理 ==========

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  password_hash String
  full_name     String?
  phone         String?
  role          String   @default("operator") // admin / manager / operator / viewer
  status        String   @default("active") // active / disabled
  // 停用原因：auto_attempts（登录失败次数过多被系统自动停用）/ manual（管理员手动停用）/ null（启用或未停用）
  // 用于超管平台区分「自动锁定」与「人工停用」，便于针对性恢复（P-account-auto-disable-visibility, 2026-08-20）
  disabled_reason String?
  school_code   String?  // 所属学校代码（方案②）；dev/test 共享 schema 时为空
  // Viewer 账号申请审批（P13 衍生需求）：审批通过即开放全部模块（含病原体）只读。
  can_view_pathogen Boolean @default(false)
  // M2（窗口2）：默认/临时密码账号首登强制改密标记。
  // 建校初始 manager、管理员重置密码时置 true；登录侧拦截由窗口1实现。
  must_change_password Boolean @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  last_login    DateTime?

  audit_logs    AuditLog[]
  test_records  TestRecord[]
  guests        Guest[]
  sessions      Session[]
}

// ========== 校外人员 viewer 账号申请（需学校 manager 审批）==========
// 提交端：登录页「申请 viewer 账号」；审批端：学校端 UserManagement 审批标签页。
// 状态机：pending → approved（创建 viewer User）| rejected。
model AccountApplication {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?
  phone        String?
  full_name    String?
  password_hash String
  // 申请时是否要求查看病原体数据；审批通过后统一开放全部模块（含病原体）只读
  view_pathogen Boolean @default(true)
  status       String   @default("pending") // pending / approved / rejected
  school_code  String?  // 申请人目标学校（提交时由前端传 schoolCode）
  reviewer_id  String?  // 审批人 user.id
  review_note  String?  // 审批备注/拒绝原因
  created_at   DateTime @default(now())
  reviewed_at  DateTime?

  @@index([status])
  @@index([school_code])
}

// ========== 审计日志 ==========

model AuditLog {
  id            String   @id @default(cuid())
  user_id       String
  action        String   // login / create / update / delete / export / import
  resource_type String?  // test_record / user / backup / etc
  resource_id   String?
  details       Json?  // JSON object for additional details (P1-4: 升级 jsonb)
  ip_address    String?
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

// ========== 测试记录 ==========

model TestRecord {
  id            String   @id @default(cuid())
  record_code   String   @unique
  test_type     String   // pathogen / tableware / generic / custom
  test_name     String
  sample_info   Json   @default("{}") // JSON for sample details (D-02: 非空，默认 {})
  result_data   Json   @default("{}") // JSON for test results (D-02: 非空，默认 {})
  status        String   @default("pending") // pending / completed / failed / archived
  created_by    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  version       Int      @default(0)
  data_version  Int      @default(1) // RK48: 业务数据版本，便于定制变更后的兼容性读取/回填
  completed_at  DateTime?

  created_user  User     @relation(fields: [created_by], references: [id], onDelete: Restrict) // P1-08: 改为 Restrict，防止删用户时级联删除检测记录
  test_items    TestItem[]
  attachments   Attachment[]

  @@index([test_type])
  @@index([status])
  @@index([created_by])
  @@index([created_at])
  // D-10：统计查询常按「类型 + 时间」过滤（无独立 test_date 列，日期在 result_data JSON 内，
  // 故用 created_at 组合索引兜底）
  @@index([test_type, created_at])
}

// ========== 测试项目 ==========

model TestItem {
  id            String   @id @default(cuid())
  test_record_id String
  item_name     String
  item_code     String?
  result        String?  // positive / negative / qualified / unqualified / etc
  notes         String?
  created_at    DateTime @default(now())

  test_record   TestRecord @relation(fields: [test_record_id], references: [id], onDelete: Cascade)

  @@index([test_record_id])
}

// ========== 附件/文件 ==========

model Attachment {
  id            String   @id @default(cuid())
  test_record_id String?
  file_name     String
  file_path     String
  file_size     Int?     // bytes
  file_type     String?  // MIME type
  uploaded_at   DateTime @default(now())

  test_record   TestRecord? @relation(fields: [test_record_id], references: [id], onDelete: SetNull)

  @@index([test_record_id])
}

// ========== 访客管理 ==========
// 注意：Guest 与 GuestExportRequest 均为「每校业务数据」，落在租户 schema
// （真实 schema 名 = school_<code>，由 schemaNameOf 归一），由应用层经
// createTenantClient(prisma, schoolCode) 返回的独立 PrismaClient 路由（非 SET search_path）；
// 与 User / AuditLog / TestRecord / Session 同属租户级模型。

model Guest {
  id                   String    @id @default(cuid())
  username             String    @unique
  email                String?
  password_hash        String
  full_name            String?
  // 自注册访客无创建者用户，故允许为空（P1-08 同款 Restrict 关系仅在非空时生效）
  created_by           String?
  // 实际只写入 'readonly'：访客自助注册与导出/病原体申请审批入口均已下线（对应路由已删除），
  // 故 export_applicant 已是死枚举值，仅作历史兼容保留。
  guest_type           String    @default("readonly") // readonly（只读）/ export_applicant（导出申请人，历史别名，已无写入路径）
  // 以下三个布尔字段为遗留结构：应用层无任何路径会将其置为 true（签发方硬写 false，审批入口已删除）。
  has_export_permission Boolean  @default(false)   // 导出权限（恒定 false；原需 export 申请审批，该审批流已下线）
  can_view_pathogen    Boolean   @default(false)   // 查看病原体数据权限（恒定 false；原需 pathogen_access 审批，已下线）
  request_pathogen_view Boolean  @default(false)   // 「希望查看病原体」意向（仅标记；原自助注册登记用，注册已关闭）
  valid_until          DateTime? // 访客有效期（quick-access 按签发时刻 +2h 计算）
  status               String    @default("active") // active / disabled
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  created_user         User?     @relation(fields: [created_by], references: [id], onDelete: SetNull)
  export_requests      GuestExportRequest[]

  @@index([created_by])
  @@index([guest_type])
  @@index([can_view_pathogen])
}

// ========== 访客导出申请 ==========

model GuestExportRequest {
  id             String   @id @default(cuid())
  guest_id       String
  request_type   String   // 申请类型：pathogen_access（查看病原体）/ export（数据导出）
  request_reason String?
  request_data   Json?  // JSON，附加数据 (P1-4: 升级 jsonb)
  status         String   @default("pending") // pending / approved / rejected
  reviewed_by    String?  // 审批人（User.id）
  reviewed_at    DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  guest          Guest    @relation(fields: [guest_id], references: [id], onDelete: Cascade)

  @@index([guest_id])
  @@index([status])
}

// ========== 运维备份执行记录（P0 备份引擎）==========
// 系统级运维实体：记录每次 pg_dump 逻辑备份的执行结果。
// ⚠️ 权威副本位于 public schema（备份服务经基础 prisma 单例显式读写 public."BackupRun"）；
// 由于 provisionSchool 对每租户 schema 执行全量 db push，本模型会冗余存在于各租户 schema，
// 与 School/SchoolCustomization 的双份现状一致——租户侧的冗余空表忽略，不参与读写。
// created_by 存 super_admin username 或 'system'（不建外键：备份是平台实体，跨 schema 外键不可达）。

model BackupRun {
  id            String   @id @default(cuid())
  run_type      String   // scheduled_all | scheduled_school | manual_all | manual_school
  scope         String   // all | single
  schema_name   String?  // 单校时 school_<code>（已归一）；全库为 null
  school_code   String?  // 学校代码（UI 展示 / 筛选用）
  file_path     String   @unique
  file_size     Int?
  table_counts    Json?  // JSON {"schema.table": count}，供 L2 恢复后行数对比 (P1-4: 升级 jsonb)
  schema_snapshot Json?  // JSON {"schema": {"table": [{column,type}]}}，备份时结构快照 (2026-08-20)
  checksum        String?  // 备份文件（gz 压缩流）的 sha256（与 meta.json 同值，恢复时校验）
  encrypted     Boolean  @default(true)
  status        String   @default("pending") // pending | running | ok | error
  verify_status String?  // pending | passed | failed（L1/L2 自动验证结果）
  created_at    DateTime @default(now())
  created_by    String?  // 触发人（super_admin username）或 'system'

  @@index([created_at])
  @@index([school_code])
  @@index([status])
}

// ========== 浏览器测试：用例/问题 + 执行记录（重构版 TR-Rewrite）==========
// 语义对齐检测业务模型（检测计划/风险上报 → 复检 → 合格 → 结案）：
//   TestCase      用例/问题（状态承载体），TestExecution 每次执行一行（追加式，
//   保留完整复测轨迹：失败→修复→复测→…→通过）。
//   source=task   后台安排的测试任务（case_key=CASE_DEFS 用例编号，含执行指引 guide）；
//   source=issue  测试人员自发反馈的问题（上报时动态创建，第 1 轮 execution 即反馈本身）。
//   当前状态 = 最新一条 TestExecution.result（读取时派生）；收口/修复标记为用例级字段。
// 权威副本位于 public schema（与 BackupRun 同模式：provisionSchool 全量 db push 会产生
// 租户侧冗余空表，忽略即可）。任意已登录账号可提交/收口（authenticateUser，测试场景）。

model TestCase {
  id                  String    @id @default(cuid())
  case_key            String    @unique // 业务键：任务用例编号（Q1-果蔬阶段A）或反馈编号（ISS-xxx）
  source              String    @default("task") // task / issue
  group               String    // 分组：wcn_业务 / zsp_备份 / retest_复测 / new_问题反馈
  title               String
  guide               String?   // 执行指引（task 专属，来自 CASE_DEFS）
  reported_by         String?   // 反馈人姓名（issue 专属）
  reported_at         DateTime? // 反馈时间（issue 专属）
  fixed_pending_retest Boolean   @default(false) // 已修复·待复测标记（开发打标）
  fixed_note          String?   // 修复说明
  closed              Boolean   @default(false)
  closed_by           String?   // 收口操作人 username
  closed_at           DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  executions TestExecution[]

  @@index([source])
  @@index([group])
  @@index([closed, fixed_pending_retest])
}

model TestExecution {
  id          String   @id @default(cuid())
  case_id     String   // → TestCase.id
  round       Int      // 第几轮（同 case 内从 1 自增）
  result      String   // passed / failed / skipped
  detail      String?  // 问题描述 / 复现步骤 / 期望 vs 实际
  evidence    String?  // JSON 数组字符串：证据 URL 列表
  tester_name String   // 测试人员姓名（身份卡必填，提交人标识）
  tester_role String?  // 登录账号角色（辅助）
  executed_at DateTime @default(now())

  testCase TestCase @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id, round])
  @@index([tester_name])
}

// ========== 会话管理（TD-Session）==========
// 每校业务数据，落在租户 schema（与 User / AuditLog 同级）。记录活跃登录会话，
// 支撑「强制登出其它设备」「并发会话限制」等能力。由前端 SessionManager 在登录/
// 登出时经 /api/session 同步。

model Session {
  id            String   @id @default(cuid())
  user_id       String
  session_token String?  // 前端生成的会话标识（sess_...），用于注销指定会话
  device_type   String?  // Desktop / Mobile / Tablet
  browser       String?
  user_agent    String?
  ip_address    String?
  status        String   @default("active") // active / revoked
  login_at      DateTime @default(now())
  last_seen_at  DateTime @default(now())
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

// ========== 字段选项表（级联配置，租户级）==========
// 动态表单字段级联配置的【唯一数据源】。支持任意层级（parent_option_id 自引用）：
//   - 顶级行（parent_option_id IS NULL）：某 (module_code, field_code) 字段的可选值；
//   - 子行（parent_option_id 指向其它选项）：表示"父选项被选中时，本选项可用"。
//     （子行 field_code 通常为目标字段，如 tableware.testType='atp' 的子行是
//       tableware.location 的选项，实现"检测项目 → 检测点位"跨字段联动。）
// value 为机器值（如 atp / detergent），label 为显示文本（如 表面清洁度），二者可分离。
// 说明：
//   - 历史检测记录存的是选项文本快照，删除选项不影响历史展示，故删除保护只约束
//     "有子选项的父选项"（由应用层校验），不强制校验历史引用计数（used_count 保留扩展用）。
//   - PostgreSQL 唯一索引对 NULL 不生效，顶级行（parent IS NULL）的唯一性由应用层
//     fieldOptionService 在写入前查重保证；子行（parent 非 NULL）受本表唯一约束保护。
//   - 本表仅覆盖"需要级联/多级结构的字段"（当前：tableware.testType / tableware.location）；
//     普通平面下拉字段的选项仍存 SchoolCustomization.field_options（JSON），两套体系互不干扰。

model FieldOption {
  id               String   @id @default(cuid())
  module_code      String   // 模块码（tableware / pesticide / oil / leanMeat）
  field_code       String   // 字段名（testType / location）
  value            String   // 机器值（唯一键组成部分；顶级行整体唯一）
  label            String   // 显示文本（默认 = value）
  parent_option_id String?  // 父选项 id（NULL = 顶级选项）
  parent           FieldOption? @relation("FieldOptionChildren", fields: [parent_option_id], references: [id], onDelete: Cascade)
  children         FieldOption[] @relation("FieldOptionChildren")
  sort_order       Int      @default(0)    // 同父内的展示顺序
  is_default       Boolean  @default(false) // 录入表单默认选中项
  is_builtin       Boolean  @default(false) // 系统种子选项标记（供重置/界面提示）
  used_count       Int      @default(0)    // 历史记录引用计数（预留扩展，当前不做强制删除保护）
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([module_code, field_code, value, parent_option_id])
  @@index([module_code, field_code, parent_option_id])
  @@index([parent_option_id])
}

// ========== 系统日志 ==========

model SystemLog {
  id            String   @id @default(cuid())
  level         String   // info / warn / error / debug
  message       String
  context       Json?  // JSON (P1-4: 升级 jsonb)
  created_at    DateTime @default(now())

  @@index([level])
  @@index([created_at])
}

// ========== 学校注册表（系统级，位于 public schema）==========

model School {
  id            String   @id @default(cuid())
  code          String   @unique // 学校代码，即 PostgreSQL schema 名（无前缀，如 school-a）
  name          String
  short_name    String?  // P1-1: 简称全校唯一（UNIQUE 索引，NULL 允许多个）
  theme_color   String?  // 主题色（外观个性化）
  logo_url      String?
  status        String   @default("active") // active / disabled
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  customization SchoolCustomization? @relation("SchoolCustomization")

  @@unique([short_name])
}

// ========== 学校定制配置（外观 / 字段个性化，位于 public schema）==========

model SchoolCustomization {
  id            String   @id @default(cuid())
  school_code   String   @unique // 与 School.code 对应
  // D-04：学校删除时定制配置级联删除，避免孤儿记录
  school        School   @relation("SchoolCustomization", fields: [school_code], references: [code], onDelete: Cascade)
  // 可见检测类型（JSON 数组，如 ["tableware","pathogen"]）
  visible_types      Json?  // JSON array
  // 侧边栏菜单项可见性（JSON 数组，如 ["dashboard","tableware",...,"logout"]）
  // 用于菜单栏定制：管理员可单独控制每个侧边菜单项的显隐
  // （退出登录项 canHide=false 强制始终显示，应用层兜底过滤）
  visible_menu_items Json?  // JSON array
  // 学校食堂信息（JSON 数组，如 ["一食堂","二食堂","三食堂"]）
  // 学校基本信息，保存时同步写入 field_options.canteen，使录入表单下拉自动应用
  canteens Json?  // JSON array
  // 字段标签覆盖（JSON，如 {"testDate":"检测日期"}）
  field_labels  Json?  // JSON object
  // 隐藏字段（JSON 数组）
  hidden_fields Json?  // JSON array
  // 其它主题设置（JSON）
  theme_config  Json?  // JSON object
  // 字段级规则（JSON，如 {"sampler":{"required":true},"note":{"required":false,"maxLength":200}}）
  field_rules   Json?  // JSON object
  // 下拉选项覆盖（JSON object，{ 字段名: [选项...] }）——顶层形态，兼容 theme_config 嵌套形态
  field_options Json?  // JSON object
  field_types  Json?  // JSON object { fieldName: 'text'|'number'|'date'|'select'|'textarea'|'checkbox' }
  // 字段顺序覆盖（JSON object，{ 模块code: [字段名...] }）
  field_order   Json?  // JSON object
  // 层级A：模块内新增自定义字段（JSON object，{ 模块code: [{name,label,type,options,statRole,...}] }）
  custom_fields Json?  // JSON object
  // 层级B：全新检测类型定义（JSON array，[{code,name,fields:[...],statRole,...}]）
  test_types    Json?  // JSON array
  // 访客功能开关（RBAC 收敛）：false=该校关闭访客扫码只读入口（登录页访客 Tab 隐藏）。
  // 由平台超管在 admin-schools.html 按校配置；默认关闭（需超管显式开启）。
  guest_enabled Boolean  @default(false)
  updated_at    DateTime @updatedAt
}

// ========== N1：检测频率阈值 ==========
// 每个检测项目的每周目标检测次数（学校 manager 可调整，平台超管可设默认）
model FrequencyThreshold {
  id            String   @id @default(cuid())
  school_code   String
  test_type     String   // tableware | pesticide | oil | leanMeat | pathogen
  weekly_target Int      // 每周目标次数
  updated_at    DateTime @updatedAt

  @@unique([school_code, test_type])
}

// ========== N2：检测日历 ==========
// 各检测项目按周几安排的检测计划（每日登录自动提示今日项目）
model DetectionCalendar {
  id          String  @id @default(cuid())
  school_code String
  test_type   String  // tableware | pesticide | oil | leanMeat | pathogen
  day_of_week Int     // 1-7（周一~周日）
  enabled     Boolean @default(true)
  updated_at  DateTime @updatedAt

  @@unique([school_code, test_type, day_of_week])
}
